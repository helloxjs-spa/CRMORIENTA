# Banco de dados
#   Desenvolvimento sem instalar nada: Postgres embutido (PGlite) persistido em disco.
DATABASE_URL=pglite://.data/pglite
#   Produção / Postgres real:
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/crm_polo

# Duração da sessão de login, em horas.
SESSION_TTL_HOURS=12

# Senha atribuída aos usuários fictícios do seed.
SEED_PASSWORD=Senha@123
